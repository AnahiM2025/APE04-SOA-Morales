# PLANTILLA SIN VALORES REALES. Copie a scripts\env.ps1 (excluido de Git), complete y ejecute:  . .\scripts\env.ps1
# Use claves largas y aleatorias; nunca las suba al repositorio.

# --- MySQL (XAMPP) ---
$env:DB_HOST = "127.0.0.1"; $env:DB_PORT = "3306"; $env:DB_USER = "root"; $env:DB_PASSWORD = ""

# --- API Java de vehiculos (instancias A y B DEBEN compartir estos valores) ---
$env:APP_JWT_SECRET      = "<minimo 32 caracteres aleatorios>"
$env:APP_CLIENT_ID       = "vehiculos-client"
$env:APP_CLIENT_SECRET   = "<secreto del cliente OAuth>"
$env:VENTAS_SERVICE_KEY  = "<minimo 32 caracteres; igual en Python>"
$env:NOTIFICACIONES_KEY  = "<minimo 32 caracteres; igual en notificaciones>"
$env:SPRING_PROFILES_ACTIVE = "local"                 # solo la 1a vez: crea admin / operador / consulta
$env:APP_BOOTSTRAP_PASSWORD = "<clave de laboratorio, minimo 8 caracteres>"

# --- RabbitMQ ---
$env:RABBITMQ_USER = "<usuario>"; $env:RABBITMQ_PASSWORD = "<clave>"
$env:RABBITMQ_QUEUE = "notificaciones.ventas"

# --- Clientes y scripts de prueba ---
$env:API_BASE_URL = "http://127.0.0.1:8090"           # NGINX
$env:LAB_PASSWORD = $env:APP_BOOTSTRAP_PASSWORD       # la usa scripts\pruebas.py para admin/operador/consulta
