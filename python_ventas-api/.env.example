# Plantilla SIN valores reales. Copiar a .env (que NO se publica en Git) y completar.
# Base de datos (XAMPP/MySQL local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ventas_compradores
DB_USER=root
DB_PASSWORD=

# Java de vehiculos A TRAVES DE NGINX (punto unico de entrada)
JAVA_URL=http://127.0.0.1:8090

# Debe coincidir con app.security.ventas-key de Java (minimo 32 caracteres)
VENTAS_SERVICE_KEY=COLOCA_AQUI_UNA_CLAVE_DE_AL_MENOS_32_CARACTERES

# RabbitMQ: publicacion de eventos de venta
RABBITMQ_URL=amqp://USUARIO:CLAVE@127.0.0.1:5672/%2F
RABBITMQ_QUEUE=notificaciones.ventas
